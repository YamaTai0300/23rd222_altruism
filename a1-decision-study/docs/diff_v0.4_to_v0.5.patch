+pages = []
+for title, old, new, note in ROWS:
+    c = Image.new('RGB', (W, H), 'white')
+    d = ImageDraw.Draw(c)
+    d.text((40, 30), title, fill='#111', font=f_title)
+    d.text((40, 90), note, fill='#444', font=f_note)
+    d.text((60, TOP - 40), 'v0.4（修正前）', fill='#555', font=f_sub)
